<?xml version="1.0" encoding="utf-8"?>
<!-- Panneaux du lecteur : verre sombre plus dense (lisible même sur une image très claire) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#D10C0E14" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="270" android:endColor="#00FFFFFF" android:startColor="#10FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#24FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
