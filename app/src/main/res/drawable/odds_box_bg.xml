<?xml version="1.0" encoding="utf-8"?>
<!-- Pastille des cotes d'un match à venir : OK ouvre le comparateur -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="140" android:exitFadeDuration="110">
    <item android:state_focused="true"><shape><solid android:color="#2EFFFFFF" /><stroke android:width="2dp" android:color="#FFFFFF" /><corners android:radius="10dp" /></shape></item>
    <item><shape><solid android:color="#0DFFFFFF" /><stroke android:width="1dp" android:color="#1AFFFFFF" /><corners android:radius="10dp" /></shape></item>
</selector>
