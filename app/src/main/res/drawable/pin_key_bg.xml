<?xml version="1.0" encoding="utf-8"?>
<!-- Touche du pavé de code : ronde, en verre, blanche au focus -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="120" android:exitFadeDuration="100">
    <item android:state_focused="true"><shape android:shape="oval"><solid android:color="#FFFFFF" /></shape></item>
    <item><shape android:shape="oval"><solid android:color="#1AFFFFFF" /><stroke android:width="1dp" android:color="#26FFFFFF" /></shape></item>
</selector>
