<?xml version="1.0" encoding="utf-8"?>
<!-- Fenêtre en verre : fond profond, liseré clair, reflet discret en haut -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#F5161821" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="270" android:endColor="#00FFFFFF" android:startColor="#14FFFFFF" android:type="linear" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#24FFFFFF" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</layer-list>
