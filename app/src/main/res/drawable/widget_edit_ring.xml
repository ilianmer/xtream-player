<?xml version="1.0" encoding="utf-8"?>
<!-- Contour des widgets en mode personnalisation : discret au repos, blanc au focus -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="120">
    <item android:state_focused="true"><shape><solid android:color="#14FFFFFF" /><stroke android:width="3dp" android:color="#FFFFFF" /><corners android:radius="16dp" /></shape></item>
    <item><shape><solid android:color="#00000000" /><stroke android:width="1.5dp" android:color="#59FFFFFF" android:dashWidth="7dp" android:dashGap="5dp" /><corners android:radius="16dp" /></shape></item>
</selector>
