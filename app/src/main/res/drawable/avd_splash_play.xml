<?xml version="1.0" encoding="utf-8"?>
<!-- Ouverture : le contour doré se trace, le play se remplit en dégradé, puis un petit battement -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/splash_play_vec">
    <target android:name="play">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="540"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="trimPathEnd"
                    android:startOffset="260"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="340"
                    android:interpolator="@android:interpolator/decelerate_quad"
                    android:propertyName="fillAlpha"
                    android:startOffset="660"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="320"
                    android:propertyName="strokeAlpha"
                    android:startOffset="900"
                    android:valueFrom="1"
                    android:valueTo="0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="playGroup">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <set android:ordering="together">
                    <objectAnimator android:duration="200" android:propertyName="scaleX" android:startOffset="720" android:valueFrom="1" android:valueTo="1.09" android:valueType="floatType" android:interpolator="@android:interpolator/decelerate_quad" />
                    <objectAnimator android:duration="200" android:propertyName="scaleY" android:startOffset="720" android:valueFrom="1" android:valueTo="1.09" android:valueType="floatType" android:interpolator="@android:interpolator/decelerate_quad" />
                </set>
                <set android:ordering="together">
                    <objectAnimator android:duration="360" android:propertyName="scaleX" android:valueFrom="1.09" android:valueTo="1" android:valueType="floatType" android:interpolator="@android:interpolator/overshoot" />
                    <objectAnimator android:duration="360" android:propertyName="scaleY" android:valueFrom="1.09" android:valueTo="1" android:valueType="floatType" android:interpolator="@android:interpolator/overshoot" />
                </set>
            </set>
        </aapt:attr>
    </target>
</animated-vector>
