<?xml version="1.0" encoding="utf-8"?>
<!-- Écran quitté : il recule doucement derrière le nouveau -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_quad"
    android:shareInterpolator="true"
    android:zAdjustment="bottom">
    <alpha android:duration="260" android:fromAlpha="1" android:toAlpha="0" />
    <scale android:duration="320" android:fromXScale="1" android:fromYScale="1"
        android:pivotX="50%" android:pivotY="50%" android:toXScale="0.97" android:toYScale="0.97" />
</set>
