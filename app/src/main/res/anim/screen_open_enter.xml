<?xml version="1.0" encoding="utf-8"?>
<!-- Nouvel écran : il arrive en fondu en se posant légèrement (zoom 104 % -> 100 %) -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic"
    android:shareInterpolator="true">
    <alpha android:duration="260" android:fromAlpha="0" android:toAlpha="1" />
    <scale android:duration="320" android:fromXScale="1.04" android:fromYScale="1.04"
        android:pivotX="50%" android:pivotY="50%" android:toXScale="1" android:toYScale="1" />
</set>
