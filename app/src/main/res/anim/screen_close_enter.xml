<?xml version="1.0" encoding="utf-8"?>
<!-- Retour : l'écran précédent revient au premier plan -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic"
    android:shareInterpolator="true"
    android:zAdjustment="bottom">
    <alpha android:duration="240" android:fromAlpha="0" android:toAlpha="1" />
    <scale android:duration="300" android:fromXScale="0.97" android:fromYScale="0.97"
        android:pivotX="50%" android:pivotY="50%" android:toXScale="1" android:toYScale="1" />
</set>
