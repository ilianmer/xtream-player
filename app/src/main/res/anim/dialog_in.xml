<?xml version="1.0" encoding="utf-8"?>
<!-- Fenêtre : apparition douce avec un léger ressort -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:shareInterpolator="false">
    <alpha android:duration="180" android:fromAlpha="0" android:toAlpha="1"
        android:interpolator="@android:interpolator/decelerate_quad" />
    <scale android:duration="300" android:fromXScale="0.92" android:fromYScale="0.92"
        android:pivotX="50%" android:pivotY="50%" android:toXScale="1" android:toYScale="1"
        android:interpolator="@android:interpolator/overshoot" />
</set>
