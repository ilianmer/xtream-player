<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textViewStyle">@style/Txt</item>
        <item name="android:windowAnimationStyle">@style/Fade</item>
        <item name="android:soundEffectsEnabled">false</item>
    </style>

    <!-- Navigation entre écrans : fondu + léger zoom (l'écran se « pose »), comme sur les plateformes -->
    <style name="Fade" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/screen_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/screen_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/screen_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/screen_close_exit</item>
        <item name="android:taskOpenEnterAnimation">@anim/screen_open_enter</item>
        <item name="android:taskOpenExitAnimation">@anim/screen_open_exit</item>
    </style>

    <style name="DialogMotion" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/dialog_in</item>
        <item name="android:windowExitAnimation">@anim/dialog_out</item>
    </style>

    <style name="PlayerTheme" parent="AppTheme">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Fenêtres de dialogue en verre sombre -->
    <style name="GlassDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/glass_dialog</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:backgroundDimAmount">0.7</item>
        <item name="android:windowAnimationStyle">@style/DialogMotion</item>
        <item name="android:colorBackground">#181A24</item>
        <item name="android:soundEffectsEnabled">false</item>
    </style>

    <!-- Fenêtres de l'appli (choix, confirmations) : verre sur fond assombri, apparition animée -->
    <style name="SheetDialog" parent="@android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.72</item>
        <item name="android:windowAnimationStyle">@style/DialogMotion</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:soundEffectsEnabled">false</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
    </style>

    <style name="SyncStep" parent="Txt">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/outfit_medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_faint</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="Txt" parent="@android:style/Widget.Material.TextView">
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="Title" parent="Txt">
        <item name="android:fontFamily">@font/bebas_neue</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Semi" parent="Txt">
        <item name="android:fontFamily">@font/outfit_semibold</item>
    </style>

    <style name="Medium" parent="Txt">
        <item name="android:fontFamily">@font/outfit_medium</item>
    </style>

    <style name="Section" parent="Semi">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="Tab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:background">@drawable/tab_bg</item>
        <item name="android:textColor">@color/tab_text</item>
        <item name="android:fontFamily">@font/outfit_medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:background">@drawable/field_bg</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">#8E939D</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:singleLine">true</item>
        <item name="android:imeOptions">actionNext</item>
    </style>

    <style name="FieldLabel" parent="Txt">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_dim</item>
    </style>

    <style name="Btn">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/btn_bg</item>
        <item name="android:textColor">@color/btn_text</item>
        <item name="android:fontFamily">@font/outfit_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableTint">@color/btn_text</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Pill" parent="Btn">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_marginTop">0dp</item>
        <item name="android:layout_marginEnd">10dp</item>
    </style>

    <style name="IconBtn">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:padding">9dp</item>
        <item name="android:background">@drawable/round_btn_bg</item>
        <item name="android:tint">@color/btn_text</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="StepRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="StepNum" parent="Semi">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:background">@drawable/num_circle</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="StepText" parent="Txt">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>
</resources>
