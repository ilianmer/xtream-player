<?xml version="1.0" encoding="utf-8"?>
<!-- Création de l'avatar : aperçu en grand à gauche (en direct), galerie et couleurs à droite -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home"
    android:clipChildren="false">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_home" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingStart="30dp"
        android:paddingTop="22dp"
        android:paddingEnd="30dp">

        <!-- Aperçu -->
        <FrameLayout
            android:layout_width="320dp"
            android:layout_height="match_parent"
            android:clipChildren="false">

            <View
                android:id="@+id/glow"
                android:layout_width="400dp"
                android:layout_height="400dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="-60dp"
                android:alpha="0.9" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="10dp">

                <View
                    android:id="@+id/preview"
                    android:layout_width="190dp"
                    android:layout_height="190dp"
                    android:elevation="10dp" />

                <TextView
                    android:id="@+id/pickWho"
                    style="@style/Semi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/pickName"
                    style="@style/Medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="@color/accent"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnDone"
                    style="@style/Pill"
                    android:layout_height="38dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginEnd="0dp"
                    android:text="Terminé" />
            </LinearLayout>
        </FrameLayout>

        <!-- Galerie et couleurs -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="22dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pickTitle"
                style="@style/Semi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp" />

            <TextView
                style="@style/Txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Survole pour voir l'aperçu en direct · OK pour choisir · Retour pour garder l'ancien"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />

            <!-- Fond et anneau -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Section"
                    android:layout_width="62dp"
                    android:layout_height="wrap_content"
                    android:text="Fond" />

                <LinearLayout
                    android:id="@+id/bgRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Section"
                    android:layout_width="62dp"
                    android:layout_height="wrap_content"
                    android:text="Anneau" />

                <LinearLayout
                    android:id="@+id/ringRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingBottom="30dp"
                android:scrollbars="none" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
