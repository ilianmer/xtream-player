<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="15dp">

        <TextView
            android:id="@+id/streamTitle"
            style="@style/Semi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/btnGenres"
            style="@style/Medium"
            android:layout_width="wrap_content"
            android:layout_height="27dp"
            android:layout_marginStart="11dp"
            android:background="@drawable/pill_bg"
            android:clickable="true"
            android:drawableEnd="@drawable/ic_chevron_down_small"
            android:drawablePadding="6dp"
            android:drawableTint="@color/btn_text"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="10dp"
            android:text="Toutes les catégories"
            android:textColor="@color/btn_text"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="440dp"
        android:layout_height="158dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="15dp">

        <TextView
            android:id="@+id/sHeroTitle"
            style="@style/Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:letterSpacing="0.05"
            android:singleLine="true"
            android:textSize="46sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sHeroBadge"
                style="@style/Semi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/accent_pill"
                android:paddingStart="7dp"
                android:paddingTop="1dp"
                android:paddingEnd="7dp"
                android:paddingBottom="1dp"
                android:textColor="@color/on_accent"
                android:textSize="10sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/sHeroMeta"
                style="@style/Medium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:textColor="#E7E9ED"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/sHeroPlot"
            style="@style/Txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.1"
            android:maxLines="2"
            android:textColor="#D0D4DB"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/sHeroPlay"
                style="@style/Pill"
                android:layout_height="34dp"
                android:background="@drawable/flat_btn_bg"
                android:drawableStart="@drawable/ic_play_small"
                android:text="Lecture" />

            <Button
                android:id="@+id/sHeroMore"
                style="@style/Pill"
                android:layout_height="34dp"
                android:background="@drawable/flat_btn_bg"
                android:drawableStart="@drawable/ic_info_small"
                android:fontFamily="@font/outfit_medium"
                android:text="Plus d’infos" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRails"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="120dp"
        android:scrollbars="none" />
</LinearLayout>
