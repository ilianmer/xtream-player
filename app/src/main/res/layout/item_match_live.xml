<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="226dp"
    android:layout_height="match_parent"
    android:layout_marginEnd="10dp"
    android:background="@drawable/match_card_bg"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="11dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/comp"
            style="@style/Txt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#B4B9C3"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/status"
            style="@style/Semi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/status_live_bg"
            android:fontFeatureSettings="tnum"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            android:singleLine="true"
            android:textColor="#FFB3B5"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <include android:id="@+id/crestA" layout="@layout/item_crest" />

        <TextView
            android:id="@+id/teamA"
            style="@style/Semi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/scoreA"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit_bold"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/text"
            android:textSize="21sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <include android:id="@+id/crestB" layout="@layout/item_crest" />

        <TextView
            android:id="@+id/teamB"
            style="@style/Semi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/scoreB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit_bold"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/text"
            android:textSize="21sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/detail"
        style="@style/Txt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/text_faint"
        android:textSize="10sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/watch"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:background="@drawable/watch_pill_bg"
        android:duplicateParentState="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="9dp">

        <ImageView
            android:id="@+id/chLogo"
            android:layout_width="34dp"
            android:layout_height="24dp"
            android:background="@drawable/logo_tile"
            android:padding="2dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/chName"
            style="@style/Medium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/btn_text"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/chNum"
            style="@style/Txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:duplicateParentState="true"
            android:textColor="@color/btn_text"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
