<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/startRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05060A">

    <!-- Ouverture : halos qui s'allument, tuile qui se pose, play doré tracé puis rempli,
         reflet qui balaie la tuile, nom de l'appli qui se resserre ; puis on « entre » dans le play -->
    <FrameLayout
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/auraGold"
            android:layout_width="620dp"
            android:layout_height="620dp"
            android:layout_gravity="center"
            android:alpha="0"
            android:background="@drawable/splash_aura_gold"
            android:translationX="-150dp"
            android:translationY="-60dp" />

        <View
            android:id="@+id/auraViolet"
            android:layout_width="680dp"
            android:layout_height="680dp"
            android:layout_gravity="center"
            android:alpha="0"
            android:background="@drawable/splash_aura_violet"
            android:translationX="170dp"
            android:translationY="90dp" />

        <View
            android:id="@+id/splashGlow"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_gravity="center"
            android:alpha="0"
            android:background="@drawable/splash_glow"
            android:translationY="-28dp" />

        <LinearLayout
            android:id="@+id/splashCenter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/splashTileBox"
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:alpha="0">

                <ImageView
                    android:id="@+id/splashTile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/splash_tile" />

                <ImageView
                    android:id="@+id/splashPlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/avd_splash_play" />

                <View
                    android:id="@+id/splashShine"
                    android:layout_width="56dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center"
                    android:alpha="0"
                    android:background="@drawable/splash_shine"
                    android:rotation="22" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/splashWord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:alpha="0"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/splashWordA"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit_bold"
                    android:text="Xtream"
                    android:textColor="@color/text"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/splashWordB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/outfit_light"
                    android:text="Player"
                    android:textColor="#D5D8DE"
                    android:textSize="30sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Mise à jour des listes (seulement quand c'est nécessaire) -->
    <LinearLayout
        android:id="@+id/syncBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_logo" />

        <TextView
            android:id="@+id/tvSource"
            style="@style/Txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="440dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/glass_panel"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Étapes de la mise à jour : chaînes, films, séries (cochées au fur et à mesure) -->
            <LinearLayout
                android:id="@+id/syncSteps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView android:id="@+id/stepLive" style="@style/SyncStep" android:text="Chaînes" />
                <View android:layout_width="34dp" android:layout_height="1dp" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:background="#33FFFFFF" />
                <TextView android:id="@+id/stepMovie" style="@style/SyncStep" android:text="Films" />
                <View android:layout_width="34dp" android:layout_height="1dp" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:background="#33FFFFFF" />
                <TextView android:id="@+id/stepSeries" style="@style/SyncStep" android:text="Séries" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/spinner"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="340dp"
                android:layout_height="4dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/accent" />

            <TextView
                android:id="@+id/tvProgress"
                style="@style/Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/accent"
                android:textSize="15sp" />

            <TextView
                style="@style/Txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Mise à jour des listes. Avec un gros catalogue, ça peut prendre une ou deux minutes ; ensuite l'appli s'ouvre instantanément."
                android:textColor="@color/text_faint"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvError"
                style="@style/Txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/danger"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button android:id="@+id/btnRetry" style="@style/Pill" android:drawableStart="@drawable/ic_refresh_small" android:text="Réessayer" />
            <Button android:id="@+id/btnContinue" style="@style/Pill" android:text="Continuer avec les anciennes listes" />
            <Button android:id="@+id/btnSettings" style="@style/Pill" android:layout_marginEnd="0dp" android:drawableStart="@drawable/ic_settings_small" android:text="Réglages" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
