<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="48dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/text"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSource"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_dim"
        android:textSize="16sp" />

    <ProgressBar
        android:id="@+id/spinner"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="28dp"
        android:indeterminateTint="@color/accent" />

    <TextView
        android:id="@+id/tvProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/accent"
        android:textSize="17sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:maxWidth="560dp"
        android:text="Mise à jour des listes. Avec un gros catalogue, ça peut prendre une ou deux minutes ; ensuite l'appli s'ouvre instantanément."
        android:textColor="@color/text_dim"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:maxWidth="600dp"
        android:textColor="@color/danger"
        android:textSize="16sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button android:id="@+id/btnRetry" style="@style/Btn" android:layout_width="wrap_content" android:layout_marginEnd="10dp" android:paddingStart="24dp" android:paddingEnd="24dp" android:text="Réessayer" />
        <Button android:id="@+id/btnContinue" style="@style/Btn" android:layout_width="wrap_content" android:layout_marginEnd="10dp" android:paddingStart="24dp" android:paddingEnd="24dp" android:text="Continuer avec les anciennes listes" />
        <Button android:id="@+id/btnSettings" style="@style/Btn" android:layout_width="wrap_content" android:paddingStart="24dp" android:paddingEnd="24dp" android:text="Réglages" />
    </LinearLayout>
</LinearLayout>
