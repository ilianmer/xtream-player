<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/startRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05060A">

    <!-- Animation d'ouverture : la tuile apparaît, le play jaune glisse, puis on « entre » dedans -->
    <FrameLayout
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/splashGlow"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_gravity="center"
            android:alpha="0"
            android:background="@drawable/splash_glow" />

        <ImageView
            android:id="@+id/splashTile"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:alpha="0"
            android:src="@drawable/logo_tile_only" />

        <ImageView
            android:id="@+id/splashPlay"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:alpha="0"
            android:src="@drawable/logo_play_only" />
    </FrameLayout>

    <!-- Mise à jour des listes (seulement quand c'est nécessaire) -->
    <LinearLayout
        android:id="@+id/syncBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_logo" />

        <TextView
            android:id="@+id/tvSource"
            style="@style/Txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="440dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/glass_panel"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <ProgressBar
                android:id="@+id/spinner"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:indeterminateTint="@color/accent" />

            <TextView
                android:id="@+id/tvProgress"
                style="@style/Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/accent"
                android:textSize="15sp" />

            <TextView
                style="@style/Txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Mise à jour des listes. Avec un gros catalogue, ça peut prendre une ou deux minutes ; ensuite l'appli s'ouvre instantanément."
                android:textColor="@color/text_faint"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvError"
                style="@style/Txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/danger"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button android:id="@+id/btnRetry" style="@style/Pill" android:drawableStart="@drawable/ic_refresh_small" android:text="Réessayer" />
            <Button android:id="@+id/btnContinue" style="@style/Pill" android:text="Continuer avec les anciennes listes" />
            <Button android:id="@+id/btnSettings" style="@style/Pill" android:layout_marginEnd="0dp" android:drawableStart="@drawable/ic_settings_small" android:text="Réglages" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
