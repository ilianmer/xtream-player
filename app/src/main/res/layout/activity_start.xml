<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:src="@drawable/ic_logo" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_bold"
                android:text="Xtream"
                android:textColor="@color/text"
                android:textSize="28sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:fontFamily="@font/outfit_light"
                android:text="Player"
                android:textColor="#D5D8DE"
                android:textSize="28sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSource"
            style="@style/Txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="440dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/glass_panel"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <ProgressBar
                android:id="@+id/spinner"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:indeterminateTint="@color/accent" />

            <TextView
                android:id="@+id/tvProgress"
                style="@style/Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/accent"
                android:textSize="15sp" />

            <TextView
                style="@style/Txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Mise à jour des listes. Avec un gros catalogue, ça peut prendre une ou deux minutes ; ensuite l'appli s'ouvre instantanément."
                android:textColor="@color/text_faint"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvError"
                style="@style/Txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/danger"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button android:id="@+id/btnRetry" style="@style/Pill" android:drawableStart="@drawable/ic_refresh_small" android:text="Réessayer" />
            <Button android:id="@+id/btnContinue" style="@style/Pill" android:text="Continuer avec les anciennes listes" />
            <Button android:id="@+id/btnSettings" style="@style/Pill" android:layout_marginEnd="0dp" android:drawableStart="@drawable/ic_settings_small" android:text="Réglages" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
