<?xml version="1.0" encoding="utf-8"?>
<!--
  Match à venir : la ligne (OK lance la chaîne, appui long pour les options),
  puis à droite la pastille des cotes (flèche droite, OK ouvre le comparateur).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:layout_marginBottom="4dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/row_soft_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="6dp">

        <LinearLayout
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/time"
                style="@style/Semi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/day"
                style="@style/Txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_faint"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/comp"
            style="@style/Txt"
            android:layout_width="86dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text_faint"
            android:textSize="10sp" />

        <!-- Domicile et extérieur : chaque logo reste collé au nom de son équipe -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <include android:id="@+id/crestA" layout="@layout/item_crest" />

            <TextView
                android:id="@+id/teamA"
                style="@style/Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxWidth="108dp"
                android:singleLine="true"
                android:textSize="12sp" />

            <TextView
                style="@style/Txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="7dp"
                android:text="–"
                android:textColor="#6E7380"
                android:textSize="12sp" />

            <include android:id="@+id/crestB" layout="@layout/item_crest" />

            <TextView
                android:id="@+id/teamB"
                style="@style/Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxWidth="108dp"
                android:singleLine="true"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- « Serré », « Gros favori » -->
        <TextView
            android:id="@+id/tag"
            style="@style/Semi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/tag_pill_bg"
            android:paddingStart="6dp"
            android:paddingTop="1dp"
            android:paddingEnd="6dp"
            android:paddingBottom="1dp"
            android:singleLine="true"
            android:textColor="@color/accent"
            android:textSize="9sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/watch"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/chip_small"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="3dp"
            android:paddingEnd="9dp">

            <ImageView
                android:id="@+id/chLogo"
                android:layout_width="26dp"
                android:layout_height="18dp"
                android:background="@drawable/logo_tile"
                android:padding="2dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/chName"
                style="@style/Txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxWidth="110dp"
                android:singleLine="true"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Cotes : chances de chaque issue ; OK ouvre le tableau des bookmakers -->
    <FrameLayout
        android:id="@+id/oddsBox"
        android:layout_width="112dp"
        android:layout_height="match_parent"
        android:layout_marginStart="5dp"
        android:background="@drawable/odds_box_bg"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <com.ilian.xtreamplayer.OddsBarView
            android:id="@+id/oddsBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:duplicateParentState="true" />
    </FrameLayout>
</LinearLayout>
