<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <LinearLayout
            android:layout_width="560dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Le plus simple : saisis tout depuis ton téléphone. Tu peux aussi coller le lien M3U complet dans le champ serveur."
                android:textColor="@color/text_dim"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnPhone"
                style="@style/Btn"
                android:text="Saisir depuis le téléphone" />

            <EditText android:id="@+id/etName" style="@style/Field" android:hint="Nom de la source (ex : Maison)" android:inputType="text" />
            <EditText android:id="@+id/etServer" style="@style/Field" android:hint="Serveur (ex : http://exemple.com:8080)" android:inputType="textUri" />
            <EditText android:id="@+id/etUser" style="@style/Field" android:hint="Nom d'utilisateur" android:inputType="text" />
            <EditText android:id="@+id/etPass" style="@style/Field" android:hint="Mot de passe" android:imeOptions="actionDone" android:inputType="textPassword" />

            <Button
                android:id="@+id/btnSave"
                style="@style/Btn"
                android:text="Enregistrer" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/accent"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
