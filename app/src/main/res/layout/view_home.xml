<?xml version="1.0" encoding="utf-8"?>
<!-- Accueil en widgets, façon iPhone : chaque bloc se déplace, se redimensionne, s'ajoute ou se retire -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <com.ilian.xtreamplayer.BoardScrollView
        android:id="@+id/boardScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fadingEdgeLength="24dp"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/board"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingBottom="40dp" />
    </com.ilian.xtreamplayer.BoardScrollView>

    <!-- Blocs historiques de l'accueil, rangés ici tant qu'ils ne sont pas posés sur le tableau -->
    <FrameLayout
        android:id="@+id/homeStash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <include layout="@layout/widget_hero" />

        <include layout="@layout/widget_sport" />

        <include layout="@layout/widget_row" />
    </FrameLayout>

    <TextView
        android:id="@+id/editBanner"
        style="@style/Medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/toast_bg"
        android:elevation="20dp"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:text="Personnalisation · OK sur un widget : déplacer, taille, retirer · Retour : terminer"
        android:textColor="@color/text"
        android:textSize="12sp"
        android:visibility="gone" />
</FrameLayout>
