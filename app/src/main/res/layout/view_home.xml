<?xml version="1.0" encoding="utf-8"?>
<!--
  Accueil en widgets, façon iPhone : le tableau est découpé en pages de la hauteur exacte de l'écran
  (aucun widget coupé) ; chaque widget se déplace, se redimensionne, s'ajoute ou se retire.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Barre du mode personnalisation -->
        <LinearLayout
            android:id="@+id/editBar"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/glass_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="6dp"
            android:visibility="gone">

            <TextView
                style="@style/Semi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Personnaliser l'accueil"
                android:textSize="14sp" />

            <TextView
                style="@style/Txt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="OK sur un widget : déplacer · taille · retirer"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnAddWidget"
                style="@style/Pill"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:text="+  Ajouter un widget"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnResetWidgets"
                style="@style/Pill"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:text="Disposition d'origine"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnDoneWidgets"
                style="@style/Pill"
                android:layout_height="34dp"
                android:layout_marginEnd="0dp"
                android:text="Terminé"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Pages du tableau (coupées net sous la barre du haut) -->
        <com.ilian.xtreamplayer.BoardScrollView
            android:id="@+id/boardScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingTop="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/board"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical" />
        </com.ilian.xtreamplayer.BoardScrollView>
    </LinearLayout>

    <!-- Indicateur de page, comme les points de l'iPhone (à la verticale) -->
    <LinearLayout
        android:id="@+id/pageDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- Blocs historiques de l'accueil, rangés ici tant qu'ils ne sont pas posés sur le tableau -->
    <FrameLayout
        android:id="@+id/homeStash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <include layout="@layout/widget_hero" />

        <include layout="@layout/widget_sport" />

        <include layout="@layout/widget_row" />
    </FrameLayout>
</FrameLayout>
