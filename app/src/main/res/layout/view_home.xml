<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <!-- Colonne gauche : le sport en direct -->
    <LinearLayout
        android:id="@+id/sportBox"
        android:layout_width="225dp"
        android:layout_height="match_parent"
        android:background="@drawable/glass_panel"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/sportDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/live_dot_big" />

            <TextView
                android:id="@+id/sportTitle"
                style="@style/Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sport en direct" />

            <TextView
                android:id="@+id/btnAllSport"
                style="@style/Txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/small_pill_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="9dp"
                android:paddingTop="3dp"
                android:paddingEnd="9dp"
                android:paddingBottom="3dp"
                android:text="Tout voir"
                android:textColor="@color/btn_text"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sportList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/sportEmpty"
            style="@style/Txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingMultiplier="1.1"
            android:text="Chargement des scores…"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Colonne principale -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="13dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/hero"
            android:layout_width="match_parent"
            android:layout_height="248dp"
            android:background="@drawable/hero_bg"
            android:foreground="@drawable/hero_frame">

            <ImageView
                android:id="@+id/heroBlur"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/heroBackA"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/heroBackB"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/heroPoster"
                android:layout_width="134dp"
                android:layout_height="200dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="44dp"
                android:background="@drawable/poster_bg"
                android:elevation="10dp"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/scrim_left" />

            <LinearLayout
                android:id="@+id/heroContent"
                android:layout_width="380dp"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/heroTag"
                    style="@style/Medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/glass_strong_pill"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:text="À la une"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/heroTitle"
                    style="@style/Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:letterSpacing="0.05"
                    android:lineSpacingMultiplier="0.9"
                    android:maxLines="2"
                    android:textSize="44sp" />

                <TextView
                    android:id="@+id/heroMeta"
                    style="@style/Semi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:singleLine="true"
                    android:textColor="#E7E9ED"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/heroPlot"
                    style="@style/Txt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:lineSpacingMultiplier="1.1"
                    android:maxLines="2"
                    android:textColor="#C9CDD4"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/heroButtons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/heroPlay"
                        style="@style/Pill"
                        android:layout_height="36dp"
                        android:drawableStart="@drawable/ic_play_small"
                        android:text="Regarder" />

                    <ImageView
                        android:id="@+id/heroInfo"
                        style="@style/IconBtn"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Plus d'infos"
                        android:src="@drawable/ic_info" />

                    <ImageView
                        android:id="@+id/heroFav"
                        style="@style/IconBtn"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="Ma liste"
                        android:src="@drawable/ic_plus" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/heroDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="13dp"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/heroEmpty"
                style="@style/Txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Préparation de ta sélection…"
                android:textColor="@color/text_dim" />
        </FrameLayout>

        <!-- Reprendre la lecture, façon Netflix -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/rowTitle"
                style="@style/Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:text="Reprendre la lecture" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvResume"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="2dp"
                android:paddingTop="6dp"
                android:paddingEnd="20dp"
                android:scrollbars="none" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
