<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_settings">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="21dp">

        <!-- Colonne de gauche : tout est à portée, sans faire défiler la liste -->
        <LinearLayout
            android:layout_width="230dp"
            android:layout_height="match_parent"
            android:background="@drawable/glass_panel"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">

            <TextView
                style="@style/Semi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Catégories affichées"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/tvProfile"
                style="@style/Txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/glass_pill"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView android:id="@+id/tabLive" style="@style/Tab" android:layout_width="0dp" android:layout_weight="1" android:text="Direct" />
                <TextView android:id="@+id/tabMovie" style="@style/Tab" android:layout_width="0dp" android:layout_weight="1" android:text="Films" />
                <TextView android:id="@+id/tabSeries" style="@style/Tab" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="0dp" android:text="Séries" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCount"
                style="@style/Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/accent"
                android:textSize="13sp" />

            <Button android:id="@+id/btnAll" style="@style/Btn" android:layout_height="36dp" android:layout_marginTop="10dp" android:drawableStart="@drawable/ic_check_small" android:gravity="start|center_vertical" android:textSize="13sp" android:text="Tout cocher" />
            <Button android:id="@+id/btnNone" style="@style/Btn" android:layout_height="36dp" android:layout_marginTop="8dp" android:drawableStart="@drawable/ic_hide_small" android:gravity="start|center_vertical" android:textSize="13sp" android:text="Tout décocher" />
            <Button android:id="@+id/btnLang" style="@style/Btn" android:layout_height="36dp" android:layout_marginTop="8dp" android:drawableStart="@drawable/ic_refresh_small" android:gravity="start|center_vertical" android:textSize="13sp" android:text="Selon mes langues" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                style="@style/Txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chaque changement est enregistré tout de suite, pour ce profil uniquement."
                android:textColor="@color/text_faint"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnDone"
                style="@style/Btn"
                android:layout_height="38dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_accent_bg"
                android:drawableTint="@color/on_accent"
                android:text="Terminé"
                android:textColor="@color/on_accent" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="15dp"
            android:layout_weight="1"
            android:background="@drawable/glass_panel"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="14dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/tvKind"
                    style="@style/Semi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="17sp" />

                <TextView
                    style="@style/Txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OK : afficher / masquer"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCats"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="12dp"
                    android:scrollbars="none" />

                <TextView
                    android:id="@+id/tvEmpty"
                    style="@style/Txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Aucune catégorie de ce type."
                    android:textColor="@color/text_dim"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
