<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#061014">

    <ImageView
        android:id="@+id/ivBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/ivBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_series" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="36dp"
        android:paddingTop="20dp"
        android:paddingEnd="30dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="26dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btnBack"
                style="@style/Txt"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/pill_bg"
                android:clickable="true"
                android:drawableStart="@drawable/ic_back_small"
                android:drawablePadding="5dp"
                android:drawableTint="@color/btn_text"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="9dp"
                android:paddingEnd="13dp"
                android:singleLine="true"
                android:text="Séries"
                android:textColor="@color/btn_text"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/ivCover"
                android:layout_width="84dp"
                android:layout_height="126dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/poster_bg"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/tvTitle"
                style="@style/Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="0.05"
                android:lineSpacingMultiplier="0.88"
                android:maxLines="2"
                android:textSize="54sp" />

            <TextView
                android:id="@+id/tvMeta"
                style="@style/Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:singleLine="true"
                android:textColor="#E7E9ED"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvPlot"
                style="@style/Txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.15"
                android:maxLines="4"
                android:textColor="#D0D4DB"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnResume"
                    style="@style/Pill"
                    android:drawableStart="@drawable/ic_play_small"
                    android:text="Lecture"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnFav"
                    style="@style/Pill"
                    android:layout_marginEnd="0dp"
                    android:drawableStart="@drawable/ic_plus_small"
                    android:fontFamily="@font/outfit_medium"
                    android:text="Ajouter aux favoris" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="420dp"
            android:layout_height="match_parent"
            android:background="@drawable/glass_panel"
            android:orientation="vertical"
            android:padding="13dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSeasons"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:scrollbars="none" />

                <TextView
                    android:id="@+id/tvCount"
                    style="@style/Txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/text_faint"
                    android:textSize="11sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="9dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvEpisodes"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingTop="2dp"
                    android:paddingBottom="8dp"
                    android:scrollbars="none" />

                <TextView
                    android:id="@+id/tvStatus"
                    style="@style/Txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:textColor="@color/text_dim"
                    android:textSize="13sp" />
            </FrameLayout>

            <TextView
                style="@style/Txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Appui long sur OK : lire depuis le début, télécharger, marquer comme vu"
                android:textColor="@color/text_faint"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
