<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home">

    <!-- Fond : l'image à la une, très floutée -->
    <ImageView
        android:id="@+id/bgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/bgScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_home" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="21dp"
        android:paddingTop="18dp"
        android:paddingEnd="21dp"
        android:paddingBottom="16dp">

        <!-- Barre du haut -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="39dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnSearch"
                android:layout_width="150dp"
                android:layout_height="39dp"
                android:background="@drawable/search_bg"
                android:clickable="true"
                android:drawableStart="@drawable/ic_search_small"
                android:drawablePadding="9dp"
                android:drawableTint="#C3C7CF"
                android:focusable="true"
                android:fontFamily="@font/outfit"
                android:gravity="center_vertical"
                android:paddingStart="15dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:text="Rechercher"
                android:textColor="#C3C7CF"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/tabsBar"
                android:layout_width="0dp"
                android:layout_height="39dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/glass_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView android:id="@+id/tabHome" style="@style/Tab" android:text="Accueil" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <TextView android:id="@+id/tabLive" style="@style/Tab" android:text="Direct" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <TextView android:id="@+id/tabSport" style="@style/Tab" android:text="Sport" />
                <View android:id="@+id/tabSportGap" android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <TextView android:id="@+id/tabMovies" style="@style/Tab" android:text="Films" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <TextView android:id="@+id/tabSeries" style="@style/Tab" android:text="Séries" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <TextView android:id="@+id/tabFav" style="@style/Tab" android:text="Favoris" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <TextView android:id="@+id/tabDl" style="@style/Tab" android:text="Téléchargements" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sourceChip"
                android:layout_width="wrap_content"
                android:layout_height="39dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/pill_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="14dp">

                <TextView
                    android:id="@+id/profileAvatar"
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:fontFamily="@font/outfit_semibold"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvSource"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:duplicateParentState="true"
                    android:ellipsize="end"
                    android:fontFamily="@font/outfit_medium"
                    android:maxWidth="110dp"
                    android:singleLine="true"
                    android:textColor="@color/btn_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnSettings"
                style="@style/IconBtn"
                android:layout_width="39dp"
                android:layout_height="39dp"
                android:layout_marginStart="10dp"
                android:contentDescription="Réglages"
                android:padding="10dp"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="13dp"
            android:layout_weight="1">

            <include
                android:id="@+id/homeView"
                layout="@layout/view_home" />

            <include
                android:id="@+id/directView"
                layout="@layout/view_direct"
                android:visibility="gone" />

            <include
                android:id="@+id/sportView"
                layout="@layout/view_sport"
                android:visibility="gone" />

            <include
                android:id="@+id/moviesView"
                layout="@layout/view_stream"
                android:visibility="gone" />

            <include
                android:id="@+id/seriesView"
                layout="@layout/view_stream"
                android:visibility="gone" />

            <!-- Catalogues : catégories à gauche, éléments à droite -->
            <LinearLayout
                android:id="@+id/catalogView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/catPanel"
                    android:layout_width="220dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/glass_panel"
                    android:padding="6dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvCategories"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingBottom="12dp"
                        android:scrollbars="none" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                <TextView
                    android:id="@+id/gridTitle"
                    style="@style/Semi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="4dp"
                    android:textSize="20sp"
                    android:visibility="gone" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvItems"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:paddingStart="10dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="16dp"
                        android:scrollbars="none" />

                    <TextView
                        android:id="@+id/tvStatus"
                        style="@style/Txt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.15"
                        android:maxWidth="400dp"
                        android:textColor="@color/text_dim"
                        android:textSize="14sp" />
                </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
