<?xml version="1.0" encoding="utf-8"?>
<!-- À propos et mentions légales : identité de l'appli et menu à gauche, texte à droite -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_home" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="34dp"
        android:paddingTop="26dp"
        android:paddingEnd="34dp"
        android:paddingBottom="22dp">

        <LinearLayout
            android:layout_width="290dp"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/ic_logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Semi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xtream Player"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/legalVersion"
                        style="@style/Txt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_dim"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Créée par ilianmer"
                android:textColor="@color/accent"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/legalMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Texte, avec une fine barre de progression sur le côté -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="24dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/legalScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/legal_panel_bg"
                android:focusable="true"
                android:paddingStart="24dp"
                android:paddingTop="20dp"
                android:paddingEnd="24dp"
                android:paddingBottom="20dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/legalTitle"
                        style="@style/Semi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="22sp" />

                    <TextView
                        style="@style/Txt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Flèches haut / bas pour lire · Gauche pour revenir au menu"
                        android:textColor="@color/text_faint"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/legalText"
                        style="@style/Txt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:lineSpacingMultiplier="1.3"
                        android:textColor="#D9DCE2"
                        android:textSize="13sp" />
                </LinearLayout>
            </ScrollView>

            <View
                android:id="@+id/legalTrack"
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="9dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/legal_track" />

            <View
                android:id="@+id/legalThumb"
                android:layout_width="3dp"
                android:layout_height="40dp"
                android:layout_gravity="end|top"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="9dp"
                android:background="@drawable/legal_thumb" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
