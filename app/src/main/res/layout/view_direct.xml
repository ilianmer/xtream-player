<?xml version="1.0" encoding="utf-8"?>
<!--
  Direct : en haut la chaîne survolée (aperçu vidéo et fiche du programme, hauteur fixe),
  puis les catégories en pastilles, puis les chaînes en liste ou en guide des programmes.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Chaîne survolée -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/preview"
            android:layout_width="266dp"
            android:layout_height="150dp"
            android:background="@drawable/preview_bg"
            android:foreground="@drawable/preview_frame">

            <ImageView
                android:id="@+id/previewLogo"
                android:layout_width="104dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:alpha="0.85"
                android:scaleType="fitCenter" />

            <androidx.media3.ui.PlayerView
                android:id="@+id/previewVideo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="invisible" />

            <View
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_gravity="bottom"
                android:background="@drawable/overlay_grad" />

            <TextView
                android:id="@+id/previewNum"
                style="@style/Title"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_gravity="bottom|start"
                android:layout_margin="9dp"
                android:background="@drawable/num_badge"
                android:gravity="center"
                android:minWidth="32dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textSize="17sp" />

            <TextView
                style="@style/Semi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="9dp"
                android:background="@drawable/live_pill"
                android:drawableStart="@drawable/live_dot"
                android:drawablePadding="5dp"
                android:gravity="center_vertical"
                android:letterSpacing="0.06"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="EN DIRECT"
                android:textColor="#FFFFFF"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/digits"
                style="@style/Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/num_badge"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="16dp"
                android:paddingBottom="4dp"
                android:textSize="40sp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Fiche du programme : hauteur fixe, rien ne bouge d'une chaîne à l'autre -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/glass_panel"
            android:orientation="horizontal"
            android:paddingStart="15dp"
            android:paddingTop="11dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/infoLogo"
                        android:visibility="invisible"
                        android:layout_width="38dp"
                        android:layout_height="26dp"
                        android:background="@drawable/logo_tile"
                        android:padding="3dp"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/infoChan"
                        style="@style/Medium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="#C3C7CF"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/infoTitle"
                    style="@style/Semi"
                    android:layout_width="match_parent"
                    android:layout_height="25dp"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/infoTime"
                        style="@style/Txt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:textColor="#B4B9C3"
                        android:textSize="11sp" />

                    <ProgressBar
                        android:id="@+id/infoBar"
                        android:visibility="invisible"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:max="1000"
                        android:progressDrawable="@drawable/thin_track" />

                    <TextView
                        android:id="@+id/infoRemain"
                        style="@style/Txt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:singleLine="true"
                        android:textColor="#B4B9C3"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/infoDesc"
                    style="@style/Txt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:lineSpacingMultiplier="1.08"
                    android:lines="2"
                    android:maxLines="2"
                    android:textColor="#D0D4DB"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/infoNext"
                    style="@style/Txt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="132dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit_light"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:textColor="@color/text"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/clockDate"
                    style="@style/Txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#B4B9C3"
                    android:textSize="10sp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btnWatch"
                    style="@style/Btn"
                    android:layout_height="32dp"
                    android:layout_marginTop="0dp"
                    android:drawableStart="@drawable/ic_play_small"
                    android:text="Regarder"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnChanFav"
                    style="@style/Btn"
                    android:layout_height="32dp"
                    android:layout_marginTop="6dp"
                    android:drawableStart="@drawable/ic_star_outline_small"
                    android:fontFamily="@font/outfit_medium"
                    android:text="Favori"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Catégories en pastilles, affichage Liste / Guide, « Ce soir » -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <HorizontalScrollView
            android:id="@+id/chipScroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/glass_pill"
            android:clipToPadding="false"
            android:fadingEdgeLength="20dp"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            android:requiresFadingEdge="horizontal"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/chips"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/btnTonight"
            style="@style/Tab"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="0dp"
            android:background="@drawable/glass_pill_btn"
            android:text="Ce soir" />

        <!-- Liste / Guide -->
        <LinearLayout
            android:id="@+id/modeBar"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/glass_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="3dp"
            android:paddingEnd="3dp">

            <TextView android:id="@+id/modeList" style="@style/Tab" android:text="Liste" />
            <TextView android:id="@+id/modeGuide" style="@style/Tab" android:layout_marginEnd="0dp" android:text="Guide" />
        </LinearLayout>
    </LinearLayout>

    <!-- Chaînes -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/glass_panel"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp">

        <!-- Règle des heures (affichage Guide) -->
        <LinearLayout
            android:id="@+id/guideHead"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/guideDay"
                style="@style/Medium"
                android:layout_width="200dp"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />

            <com.ilian.xtreamplayer.TimeRulerView
                android:id="@+id/ruler"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvGuide"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="8dp"
                android:scrollbars="none" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="8dp"
                android:scrollbars="none"
                android:visibility="gone" />

            <TextView
                android:id="@+id/guideStatus"
                style="@style/Txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:textColor="@color/text_dim"
                android:textSize="13sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
