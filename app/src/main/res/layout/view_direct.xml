<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Haut : aperçu de la chaîne + programme sélectionné, comme sur une box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/preview"
            android:layout_width="249dp"
            android:layout_height="140dp"
            android:background="@drawable/preview_bg"
            android:foreground="@drawable/preview_frame">

            <ImageView
                android:id="@+id/previewLogo"
                android:layout_width="96dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:alpha="0.85"
                android:scaleType="fitCenter" />

            <androidx.media3.ui.PlayerView
                android:id="@+id/previewVideo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/previewNum"
                style="@style/Title"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_margin="9dp"
                android:background="@drawable/num_badge"
                android:gravity="center"
                android:minWidth="34dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textSize="18sp" />

            <TextView
                style="@style/Semi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="9dp"
                android:background="@drawable/live_pill"
                android:drawableStart="@drawable/live_dot"
                android:drawablePadding="5dp"
                android:gravity="center_vertical"
                android:letterSpacing="0.06"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="EN DIRECT"
                android:textColor="#FFFFFF"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/digits"
                style="@style/Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/num_badge"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="16dp"
                android:paddingBottom="4dp"
                android:textSize="40sp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/glass_panel"
            android:orientation="horizontal"
            android:paddingStart="15dp"
            android:paddingTop="12dp"
            android:paddingEnd="13dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/infoLogo"
                        android:layout_width="34dp"
                        android:layout_height="24dp"
                        android:background="@drawable/logo_tile"
                        android:padding="3dp"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/infoChan"
                        style="@style/Txt"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="#C3C7CF"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/infoTitle"
                    style="@style/Semi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/infoTime"
                    style="@style/Txt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:singleLine="true"
                    android:textColor="#B4B9C3"
                    android:textSize="11sp" />

                <LinearLayout
                    android:id="@+id/infoProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ProgressBar
                        android:id="@+id/infoBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        android:layout_weight="1"
                        android:max="1000"
                        android:progressDrawable="@drawable/thin_track" />

                    <TextView
                        android:id="@+id/infoRemain"
                        style="@style/Txt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="#B4B9C3"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/infoDesc"
                    style="@style/Txt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#D0D4DB"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="140dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:gravity="center"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnWatch"
                    style="@style/Btn"
                    android:layout_height="34dp"
                    android:layout_marginTop="0dp"
                    android:drawableStart="@drawable/ic_play_small"
                    android:text="Regarder"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnChanFav"
                    style="@style/Btn"
                    android:layout_height="34dp"
                    android:layout_marginTop="8dp"
                    android:drawableStart="@drawable/ic_star_outline_small"
                    android:fontFamily="@font/outfit_medium"
                    android:text="Favorite"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="108dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:background="@drawable/glass_panel"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_light"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/text"
                android:textSize="31sp" />

            <TextView
                android:id="@+id/clockDate"
                style="@style/Txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#B4B9C3"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Guide des programmes -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:background="@drawable/glass_panel"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnGroup"
                style="@style/Medium"
                android:layout_width="188dp"
                android:layout_height="match_parent"
                android:background="@drawable/small_pill_bg"
                android:clickable="true"
                android:drawableEnd="@drawable/ic_chevron_down_small"
                android:drawableTint="@color/btn_text"
                android:ellipsize="end"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="8dp"
                android:singleLine="true"
                android:textColor="@color/btn_text"
                android:textSize="12sp" />

            <com.ilian.xtreamplayer.TimeRulerView
                android:id="@+id/ruler"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="5dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvGuide"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="8dp"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/guideStatus"
                style="@style/Txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:textColor="@color/text_dim"
                android:textSize="13sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
