<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/frame"
    android:layout_width="92dp"
    android:layout_height="138dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="10dp"
    android:background="@drawable/poster_bg"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/focus_ring_9">

    <ImageView
        android:id="@+id/img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/badge"
        style="@style/Semi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:background="@drawable/accent_pill"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:textColor="@color/on_accent"
        android:textSize="8sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/overlay_grad"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingTop="16dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/name"
            style="@style/Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="3"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/sub"
            style="@style/Txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#E1E4EA"
            android:textSize="9sp" />

        <ProgressBar
            android:id="@+id/bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="4dp"
            android:max="1000"
            android:progressDrawable="@drawable/thin_track" />
    </LinearLayout>
</FrameLayout>
