<?xml version="1.0" encoding="utf-8"?>
<!-- Modifier un profil : grand avatar à gauche, réglages à droite -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home"
    android:clipChildren="false">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_home" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:clipChildren="false">

            <View
                android:id="@+id/glow"
                android:layout_width="380dp"
                android:layout_height="380dp"
                android:layout_gravity="center"
                android:alpha="0.9" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/bigAvatar"
                    android:layout_width="176dp"
                    android:layout_height="176dp"
                    android:clickable="true"
                    android:clipChildren="false"
                    android:focusable="true">

                    <View
                        android:id="@+id/avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:elevation="8dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="-8dp"
                        android:background="@drawable/profile_ring"
                        android:duplicateParentState="true"
                        android:elevation="9dp" />

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/edit_badge"
                        android:elevation="10dp"
                        android:padding="11dp"
                        android:src="@drawable/ic_edit" />
                </FrameLayout>

                <TextView
                    android:id="@+id/pName"
                    style="@style/Semi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/pAvatar"
                    style="@style/Txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>

        <ScrollView
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="36dp"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
