<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070A18">

    <ImageView
        android:id="@+id/ivBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/ivBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/ivPoster"
        android:layout_width="176dp"
        android:layout_height="264dp"
        android:layout_gravity="end"
        android:layout_marginTop="44dp"
        android:layout_marginEnd="64dp"
        android:background="@drawable/poster_bg"
        android:elevation="12dp"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_left" />

    <View
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_bottom" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingTop="20dp"
        android:paddingEnd="36dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/btnBack"
            style="@style/Txt"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/pill_bg"
            android:clickable="true"
            android:drawableStart="@drawable/ic_back_small"
            android:drawablePadding="5dp"
            android:drawableTint="@color/btn_text"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="9dp"
            android:paddingEnd="13dp"
            android:singleLine="true"
            android:text="Films"
            android:textColor="@color/btn_text"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="470dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                style="@style/Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="0.04"
                android:lineSpacingMultiplier="0.88"
                android:maxLines="2"
                android:textSize="54sp" />

            <TextView
                android:id="@+id/tvMeta"
                style="@style/Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:singleLine="true"
                android:textColor="#E7E9ED"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvPlot"
                style="@style/Txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.15"
                android:maxLines="3"
                android:textColor="#D0D4DB"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnPlay"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="9dp"
                    android:background="@drawable/btn_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <TextView
                        android:id="@+id/tvPlay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_play_small"
                        android:drawablePadding="8dp"
                        android:drawableTint="@color/btn_text"
                        android:duplicateParentState="true"
                        android:fontFamily="@font/outfit_semibold"
                        android:text="Lecture"
                        android:textColor="@color/btn_text"
                        android:textSize="14sp" />

                    <ProgressBar
                        android:id="@+id/playBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginTop="3dp"
                        android:max="1000"
                        android:progressDrawable="@drawable/thin_track"
                        android:visibility="gone" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnRestart"
                    style="@style/Pill"
                    android:layout_marginEnd="9dp"
                    android:drawableStart="@drawable/ic_restart_small"
                    android:fontFamily="@font/outfit_medium"
                    android:text="Depuis le début"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/btnFav"
                    style="@style/IconBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="9dp"
                    android:padding="11dp"
                    android:src="@drawable/ic_plus" />

                <ImageView
                    android:id="@+id/btnDownload"
                    style="@style/IconBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="11dp"
                    android:src="@drawable/ic_download" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDl"
                style="@style/Txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvCredits"
                style="@style/Txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.2"
                android:maxLines="2"
                android:textColor="@color/text_faint"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/similarBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_panel"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="9dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSimilar"
                style="@style/Semi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Tu aimeras aussi"
                android:textSize="13sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSimilar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:scrollbars="none" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
