<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="5dp"
    android:background="@drawable/row_bg"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:minHeight="50dp"
    android:paddingStart="16dp"
    android:paddingTop="11dp"
    android:paddingEnd="16dp"
    android:paddingBottom="11dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:duplicateParentState="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                style="@style/Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:textColor="@color/row_title_text"
                android:textSize="14.5sp" />

            <TextView
                android:id="@+id/desc"
                style="@style/Txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:duplicateParentState="true"
                android:lineSpacingExtra="2.5dp"
                android:textColor="@color/row_desc_text"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/value"
            style="@style/Semi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:duplicateParentState="true"
            android:gravity="end"
            android:maxWidth="230dp"
            android:textColor="@color/row_value_text"
            android:textSize="13sp"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/sw"
            android:layout_width="46dp"
            android:layout_height="27dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/switch_off"
            android:visibility="gone">

            <View
                android:id="@+id/knob"
                android:layout_width="21dp"
                android:layout_height="22dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="3dp"
                android:background="@drawable/knob" />
        </FrameLayout>

        <ImageView
            android:id="@+id/chevron"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="12dp"
            android:duplicateParentState="true"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/row_chevron"
            android:visibility="gone" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:duplicateParentState="true"
        android:progressDrawable="@drawable/slider_track"
        android:visibility="gone" />
</LinearLayout>
