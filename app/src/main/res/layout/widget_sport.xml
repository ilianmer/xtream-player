<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de l'accueil : sport en direct -->
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/sportBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/glass_panel"
        android:clipChildren="false"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/sportDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/live_dot_big" />

            <TextView
                android:id="@+id/sportTitle"
                style="@style/Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sport en direct" />

            <TextView
                android:id="@+id/btnAllSport"
                style="@style/Txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/small_pill_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="9dp"
                android:paddingTop="3dp"
                android:paddingEnd="9dp"
                android:paddingBottom="3dp"
                android:text="Tout voir"
                android:textColor="@color/btn_text"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sportList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:clipChildren="false"
            android:paddingBottom="4dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/sportEmpty"
            style="@style/Txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingMultiplier="1.1"
            android:text="Chargement des scores…"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />
    </LinearLayout>

