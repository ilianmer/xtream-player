<?xml version="1.0" encoding="utf-8"?>
<!-- Chaîne favorite dans un widget : logo, nom et programme en cours -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="150dp"
    android:layout_height="96dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="10dp"
    android:background="@drawable/poster_bg"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/focus_ring_9">

    <ImageView
        android:id="@+id/img"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:padding="12dp"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/overlay_grad"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/name"
            style="@style/Semi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/sub"
            style="@style/Txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#C9CDD4"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
